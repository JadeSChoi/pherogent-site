{
  "name": "pherogent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy --config dist/pherogent/wrangler.json",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && tsc -b",
    "test": "vitest run && npm run test:server",
    "test:server": "node --test \"tests/server/*.test.mjs\"",
    "test:e2e": "npm run db:migrate && playwright test",
    "test:watch": "vitest",
    "db:migrate": "wrangler d1 migrations apply pherogent --local",
    "db:migrate:remote": "wrangler d1 migrations apply pherogent --remote"
  },
  "dependencies": {
    "@langchain/core": "^1.4.1",
    "@langchain/langgraph": "^1.7.5",
    "hono": "^4.13.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/vitest-plugin": "^1.8.3",
    "@cloudflare/workers-types": "^5.20261117.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "miniflare": "^4.20260730.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  }
}
