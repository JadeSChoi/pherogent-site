{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/vitest-plugin/types", "vitest"],
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.worker.tsbuildinfo"
  },
  "include": ["worker", "tests", "worker-configuration.d.ts"]
}
