{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pherogent",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // The @cloudflare/vite-plugin supplies the built client directory.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pherogent",
      // Placeholder until the owner provisions the real database; local dev
      // and tests emulate D1 and never contact this id. See docs/deploy.md.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
