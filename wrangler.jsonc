{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pherogent",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // The @cloudflare/vite-plugin supplies the built client directory.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The AI kill switch ships off. Turning AI on requires flipping this to
  // "true" AND setting the OPENAI_API_KEY secret, which stays unset until the
  // owner-key gate is verified live. Paid routes also require the
  // PHEROGENT_OWNER_KEY secret unless PHEROGENT_PUBLIC_ACCESS is flipped to
  // "true", which restores the public open-with-ledger demo.
  // Spend limits may be overridden without a source edit via a
  // PHEROGENT_LIMITS JSON var (e.g. {"userRunsPerDay":5}); defaults live in
  // worker/server/budget.mjs. PHEROGENT_PRICING.pricesVerifiedOn is the
  // display-only date the owner last verified the model prices.
  "vars": {
    "PHEROGENT_AI_ENABLED": "false",
    "PHEROGENT_PUBLIC_ACCESS": "false",
    "PHEROGENT_MODEL": "gpt-5.6-terra",
    "PHEROGENT_PRICING": "{\"inputMicrosPerToken\":2,\"outputMicrosPerToken\":12,\"reservedInputMicrosPerToken\":2.5,\"pricesVerifiedOn\":\"2026-11-17\"}"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pherogent",
      // The owner's real database, provisioned via scripts/setup-cloudflare.sh;
      // local dev and tests emulate D1 and never contact this id.
      "database_id": "2bf2b6be-707e-474f-a112-b3f8073618dc",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
